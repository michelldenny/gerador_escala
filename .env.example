# Conexão privada PostgreSQL. Na Vercel, conecte Neon pelo painel Storage.
# A integração cria DATABASE_URL; POSTGRES_URL também é aceita.
# DATABASE_URL=postgresql://usuario:senha@servidor/banco?sslmode=require

# Na Vercel: linha inteira de data/editor-password.hash (Definir Senha.cmd).
# ESCALA_EDITOR_PASSWORD_HASH=<salt:hash>

# Opcional: domínio HTTPS exato, sem barra final.
# PUBLIC_ORIGIN=https://gerador-escala-irqp.vercel.app

# Apenas para desenvolvimento/recuperação local, nunca na Vercel:
# ESCALA_STORAGE=sqlite

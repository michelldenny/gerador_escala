# Caminho de uma chave de conta de serviço, guardada FORA de public/.
GOOGLE_APPLICATION_CREDENTIALS=C:/caminho-privado/conta-de-servico.json
# Preencha ao hospedar atrás de HTTPS. Não é necessário no localhost.
# PUBLIC_ORIGIN=https://gerador-de-escala-59952.web.app
# Use sqlite apenas para desenvolvimento local explícito, sem Firestore.
# ESCALA_STORAGE=sqlite
# Na Vercel, configure os valores privados no painel Environment Variables:
# FIREBASE_SERVICE_ACCOUNT_JSON=<conteúdo completo do JSON da conta de serviço>
# ESCALA_EDITOR_PASSWORD_HASH=<linha salt:hash de data/editor-password.hash>

{
  "firestore": {"rules":"firestore.rules","indexes":"firestore.indexes.json"},
  "functions":{"source":".","runtime":"nodejs22","ignore":["node_modules","data",".env",".git","tests","reference","*.zip","*service-account*.json"]},
  "hosting": {
    "public":"public",
    "ignore":["firebase.json","**/.*","**/node_modules/**"],
    "rewrites":[{"source":"/api/**","function":{"functionId":"escalaApi","region":"us-central1"}}],
    "headers":[{"source":"**","headers":[{"key":"Cache-Control","value":"no-cache"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"DENY"}]}]
  }
}
